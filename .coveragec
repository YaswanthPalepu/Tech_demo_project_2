[run]
source = .
omit = 
    */tests/*
    */test*
    */test_*
    */testing/*
    */__pycache__/*
    */venv/*
    */env/*
    */site-packages/*
    */settings/*
    */wsgi.py
    */asgi.py
    */conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    class .*\(Protocol\):
    @(abc\.)?abstractmethod

show_missing = True
skip_covered = False

[html]
directory = htmlcov